<Window x:Class="AutoClickerIA.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="245"
        Height="76"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False">

    <Border Background="#E8090909"
            BorderBrush="#A80000"
            BorderThickness="1"
            CornerRadius="7"
            Padding="12">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Background="#D50000" CornerRadius="2"/>

            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="XRMEDEIROSCLICKER"
                           Foreground="#777777"
                           FontSize="9"
                           FontWeight="Bold"/>
                <TextBlock x:Name="OverlayStatusText"
                           Text="PARADO"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="Bold"/>
                <TextBlock x:Name="OverlayDetailText"
                           Text="0 CPS  •  F8"
                           Foreground="#AAAAAA"
                           FontSize="10"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <Ellipse x:Name="OverlayStatusDot"
                     Grid.Column="2"
                     Width="10"
                     Height="10"
                     Fill="#D50000"
                     VerticalAlignment="Center"
                     Margin="12,0,0,0"/>
        </Grid>
    </Border>
</Window>
